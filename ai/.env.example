# Bu dosyayı .env olarak kopyalayabilirsin. Gerçek değerleri Git'e ekleme.
# Sunucu .env dosyasını kendiliğinden okumaz; ortam değişkenleri olarak yükle.
GEMINI_API_KEY=
# AI Studio hesabında generateContent destekleyen erişilebilir modelin kimliği.
# Ücretsiz kota modele, bölgeye ve güncel sağlayıcı koşullarına bağlıdır.
GEMINI_MODEL=
# Dış erişimde zorunlu. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AI_ACCESS_TOKEN=
AI_ALLOWED_ORIGINS=https://akbuluttahmet.github.io
AI_DAILY_LIMIT=60
